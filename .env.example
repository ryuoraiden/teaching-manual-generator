# Free Google Gemini key — no credit card required.
# Get one at https://aistudio.google.com/apikey
# Copy this file to .env.local and paste your key below.
GEMINI_API_KEY=

# Optional. Which model writes the manual. Free-tier quota is metered per model
# per day and is small (gemini-2.5-flash 429s after 20 requests/day), so
# pointing this at another model gets a separate daily bucket.
# Leave blank to use the default (gemini-2.5-flash).
GEMINI_MODEL=

# Optional. Where teacher feedback is delivered. A Discord webhook works well:
# free, keeps a searchable history, and notifies your phone.
# Server → Discord channel → Edit channel → Integrations → Webhooks → New.
# If unset, feedback is only written to the server log (`docker logs manual`).
FEEDBACK_WEBHOOK_URL=

# Optional. Discord webhook that receives one line per generation — success or
# failure. Failures are the useful part: free-tier quota exhaustion and model
# overload are otherwise invisible until a teacher complains.
# Never carries the manual text, the uploaded PDFs, or anything identifying
# the teacher. Use a different channel from FEEDBACK_WEBHOOK_URL.
USAGE_WEBHOOK_URL=
